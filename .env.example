# Copy to .env.local for machine-specific overrides. Do not commit secrets.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change_me
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
POSTGRES_VERSION=16
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=ChangeMe
DATABASE_URL="postgresql://app:ChangeMe@127.0.0.1:5433/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
MAILER_DSN=smtp://127.0.0.1:1025
MAILER_FROM=noreply@waves.local
###< symfony/mailer ###

###> app/auth ###
EMAIL_VERIFICATION_TOKEN_TTL=86400
JWT_SECRET=change_me_to_a_long_random_secret
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=2592000
###< app/auth ###

###> s3 / minio (phase 4) ###
